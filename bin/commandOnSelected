#!/bin/bash
set -o noglob
shopt -qs extglob

: ${COMMANDONSELECTED_KEY_PREFIX='[35m'}
: ${COMMANDONSELECTED_KEY_SUFFIX='[0m'}
: ${COMMANDONSELECTED_SYNTAX_PREFIX='[1;35m'}
: ${COMMANDONSELECTED_SYNTAX_SUFFIX='[0m'}
: ${COMMANDONSELECTED_SYMBOLIC_PREFIX='[3;35m'}
: ${COMMANDONSELECTED_SYMBOLIC_SUFFIX='[0m'}
: ${COMMANDONSELECTED_FILTER_PREFIX='[36m'}
: ${COMMANDONSELECTED_FILTER_SUFFIX='[0m'}

: ${COMMANDONSELECTED_COMMAND_JOINER=;}
: ${COMMANDONSELECTED_ENTRIES_MARKER='{}'}
entriesMarker="$COMMANDONSELECTED_ENTRIES_MARKER"; unset COMMANDONSELECTED_ENTRIES_MARKER
: ${COMMANDONSELECTED_FILTER_MARKER='{}'}
filterMarker="$COMMANDONSELECTED_FILTER_MARKER"; unset COMMANDONSELECTED_FILTER_MARKER
: ${COMMANDONSELECTED_POST_FILTER_MARKER='{}'}
postFilterMarker="$COMMANDONSELECTED_POST_FILTER_MARKER"; unset COMMANDONSELECTED_POST_FILTER_MARKER

: ${COMMANDONSELECTED_SELECTION_MESSAGE_MAX_ENUMERATION_COUNT:=10}

fuzzyTrigger=; callable fzf && fuzzyTrigger=z

getShortUsage()
{
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|config)
		printf %s "${usageSep}${hadTopic:+ }" '[-1|--format=single-column] [--accept-single] [--single-only]'; hadTopic=t;;&
	    ''|match)
		printf %s "${usageSep}${hadTopic:+ }" '--allow-literal-match|--allow-glob-match'; hadTopic=t;;&
	    ''|entries)
		printf %s "${usageSep}${hadTopic:+ }" '-E|--entries-separated-by ; [ENTRIES ...] ;'; hadTopic=t;;&
	    ''|stdin)
		printf %s "${usageSep}${hadTopic:+ }" '--stdin'; hadTopic=t;;&
	    ''|input)
		printf %s "${usageSep}${hadTopic:+ }" '[-g|--generator GENERATOR] [-f|--filter ''|FILTER] [--post-filter FILTER]'; hadTopic=t;;&
	    ''|output)
		printf %s "${usageSep}${hadTopic:+ }" '[-c|--command \"COMMANDLINE\" [-c ...]]'; hadTopic=t;;&
	    ''|selection)
		printf %s "${usageSep}${hadTopic:+ }" 'SELECTION'; hadTopic=t;;&
	    ''|ui)
		printf %s "${usageSep}${hadTopic:+ }" '[-p|--prompt PROMPT] [--auto-selected-entry-message MSG] [--no-entries-message MSG] [--selection-message MSG] [--interactive-selection-message MSG] [--entry-name WHAT[,PLURAL-WHAT]]'; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    local -r SELECTION="$(getShortUsage selection)"
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    ''|config)
		cat <<HELPTEXT
    --format=single-column|-1
			List one entry per line instead of the default columnar
			format.
    --accept-single	Accept a single available ENTRY without prompting the
			user.
    --single-only	The querying stops when at least one entry has been
			selected (and any additional ones are ignored and
			a warning is printed).
HELPTEXT
		hadTopic=t
		;;&
	    ''|match)
		cat <<HELPTEXT
    --allow-literal-match
			In addition to the numerical SELECTIONs, literal MATCHes
			can be passed as arguments (then the -- separator to any
			following ENTRIES is mandatory). Any entry that equals
			a MATCH is selected. Multiple arguments must be all
			MATCHes or all SELECTIONs; mixing is not allowed.
    --allow-glob-match
			In addition to the numerical SELECTIONs, MATCH globs
			(e.g. \?oo\*) can be passed as arguments (then the --
			separator to any following ENTRIES is mandatory). Any
			entry that matches an (anchored, extended) glob MATCH is
			selected. Multiple arguments must be all MATCHes or all
			SELECTIONs; mixing is not allowed.
HELPTEXT
		hadTopic=t
		;;&
	    ''|entries)
		cat <<HELPTEXT
    --entries-separated-by|-E ; [ENTRIES ...] ;
			Any arguments between ; and ; (or any other separator)
			as entries. This alternative form allows to pass
			SELECTIONs at the end and prevents the user from
			sneaking in additional ENTRIES via
			"$SELECTION -- ENTRY", and therefore is the preferred
			form and especially useful for shell aliases.
    --entries|-e [ENTRIES ...]
			ENTRIES follow, and any SELECTIONs after that, separated
			by --. This is useful for a GENERATOR that produces
			entries and takes options and parameters instead of
			filtering the passed arguments, because then the
			GENERATOR [(option-)ENTRY ...] [-- $SELECTION ...]
			syntax can be used, which is more natural than
			GENERATOR [--] $SELECTION [...] [-- (option-)ENTRY ...]
HELPTEXT
		hadTopic=t
		;;&
	    ''|stdin)
		cat <<HELPTEXT
    --stdin		Read entries from standard input; each line is one
			entry; these are appended to any entries passed via
			--entries-separated-by.
HELPTEXT
		hadTopic=t
		;;&
	    ''|input)
		cat <<HELPTEXT
    --post-filter FILTER
			Pass the selected entries as individual arguments to
			FILTER (${postFilterMarker:+either }appended${postFilterMarker:+ or replacing $postFilterMarker}), which should
			return each on a separate line, before these are passed
			to COMMANDLINE [or printed].
HELPTEXT
		hadTopic=t
		;;&
	    ''|output)
		cat <<HELPTEXT
HELPTEXT
		hadTopic=t
		;;&
	    ''|selection)
		cat <<HELPTEXT
If SELECTIONs are passed, the resulting entries are selected from them.
Selection works by numbers, starting with 1 for the first entry; you can also
use enumerations (1 3 4) and ranges (2-5 or 3-; instead of relying on brace
expansion {2..5}); negative numbers select from the end, so -1 is the last one.
/N selects all but entry N; // starts interactive subtraction from all passed
entries.${fuzzyTrigger:+
$fuzzyTrigger starts selection via fuzzy matching (using fzf).}
HELPTEXT
		hadTopic=t
		;;&
	    ''|ui)
		cat <<HELPTEXT
    --prompt|-p PROMPT	Print PROMPT before showing the entries.
    --no-entries-message MSG
			Print MSG to stderr if there are no entries to choose
			from.
    --auto-selected-entry-message MSG
			Print MSG to stderr if a single entry has been
			automatically chosen; the entry itself is referenced by
			%s in MSG.
    --selection-message MSG
			Print MSG to stderr if entries have been chosen (either
			interactively or through SELECTION, but not when
			a single entry is automatically chosen); if the number
			of entries is $COMMANDONSELECTED_SELECTION_MESSAGE_MAX_ENUMERATION_COUNT or less, the entries are enumerated;
			else, only a count is passed, both to be referenced by
			%s in MSG.
    --interactive-selection-message MSG
			Print MSG to stderr if entries have been chosen
			interactively, but not through SELECTION); if the number
			of entries is $COMMANDONSELECTED_SELECTION_MESSAGE_MAX_ENUMERATION_COUNT or less, the entries are enumerated;
			else, only a count is passed, both to be referenced by
			%s in MSG.
    --entry-name WHAT[,PLURAL-WHAT]
			Use WHAT (e.g. "line", "file", you can also pass
			a separate (non-regular) plural form: "entry,entries")
			instead of "entry" in messages.
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    local -r SELECTION="$(getShortUsage selection)"
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "$(getShortUsage config) $(getShortUsage ui) $(getShortUsage input) $(getShortUsage output) [-?|-h|--help] ..."
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "... [--] [$SELECTION ...] [-- ENTRIES ...]"
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage entries) [--] [$SELECTION ...]"
    printf 'Usage: %q %s\n' "$(basename "$1")" "... -e|--entries [ENTRIES ...] [-- $SELECTION ...]"
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage match) [--] [MATCH ...|$SELECTION ...] -- [ENTRIES ...]"
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage match) $(getShortUsage entries) [--] [MATCH ...|$SELECTION ...]"
    echo
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" "... [$(getShortUsage entries)] $(getShortUsage stdin) $(getShortUsage output)"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Read entries (one per line) from GENERATOR / standard input / passed ENTRIES,
present as a numbered list and read selections (unless SELECTIONs have already
been passed).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
Passed ENTRIES are then passed to GENERATOR for further filtering unless FILTER
is given, in which case it is passed to it, or taken as-is if FILTER is empty.
ENTRIES are ${filterMarker:+either }appended${filterMarker:+ or replace any $filterMarker}; they should be returned as
separate lines.
HELPTEXT
    getLongUsage selection
    cat <<HELPTEXT
Without SELECTIONs, show a (numbered) list of them to the user, and ask for
selections (or allow further filtering of the list by in-/excluding ranges, via
grep or any shell command, or invert the selection via //). The selected entries
are then passed to the COMMANDLINE (${entriesMarker:+either }appended${entriesMarker:+ or replacing any $entriesMarker marker})
[or printed].
HELPTEXT
    getLongUsage config ui input match entries stdin output
    cat <<HELPTEXT
EXIT STATUS:
    0	Complete success.
    2	Bad selection, invocation, wrong or missing command-line arguments.
    3	Internal error or failed assertion.
    124 There are no entries available.
    125 No entries were selected.
HELPTEXT
}
printIfDefined()
{
    local message="$1"; shift
    [ -z "$message" ] && return 1
    printf >&2 "${message}\\n" "$@"
}

isOneEntryPerLine=
isAcceptSingle=
isMultiSelect=t
isStdin=
targetCommands=
generator=
unset filter
postFilter=
matchFunction=
prompt=
noEntriesMessage=
autoSelectedEntryMessage=
selectionMessage=
interactiveSelectionMessage=
haveEntries=
typeset -a entries=()
entryName=entry
entryNamePlural=entries
option() { :; }
parameter() { :; }
parameterToSep() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { argCount "$@"; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--format=single-column|-1)
			    shift; isOneEntryPerLine=t; option config;;
	--format)	    shift
			    case "$1" in
				single-column) isOneEntryPerLine=t;;
				*) printf 'ERROR: Unknown format "%s".\n' "$1"; echo; printUsage "$0"; exit 2;;
			    esac
			    shift
			    parameter config
			    ;;
	--accept-single)    shift; isAcceptSingle=t; option config;;
	--single-only)	    shift; isMultiSelect=; option config;;
	--stdin)	    shift; isStdin=t; option stdin;;
	--generator|-g)	    shift; generator="$1"; shift; parameter input;;
	--filter|-f)	    shift; filter="$1"; shift; parameter input;;
	--post-filter)	    shift; postFilter="$1"; shift; parameter input;;
	--command|-c)	    shift; targetCommands+="${targetCommands:+ $COMMANDONSELECTED_COMMAND_JOINER }$1"; shift; parameter output;;
	--allow-literal-match)
			    shift; matchFunction=selectByMatch; option match;;
	--allow-glob-match) shift; matchFunction=selectByGlob; option match;;
	--prompt|-p)	    shift; prompt="$1"; shift; parameter ui;;
	--no-entries-message)
			    shift; noEntriesMessage="$1"; shift; parameter ui;;
	--auto-selected-entry-message)
			    shift; autoSelectedEntryMessage="$1"; shift; parameter ui;;
	--selection-message)
			    shift; selectionMessage="$1"; shift; parameter ui;;
	--interactive-selection-message)
			    shift; interactiveSelectionMessage="$1"; shift; parameter ui;;
	--entry-name)	    shift
			    case "${1:?}" in
				*,*)	entryName="${1%%,*}"
					entryNamePlural="${1#*,}"
					;;
				*)	entryName="$1"
					entryNamePlural="${1}s"
					;;
			    esac; shift; parameter ui
			    ;;
	--entries-separated-by|-E)
			    originalArgNum=$#; shift
			    sep="${1:?}"; shift
			    until [ "$1" = "$sep" ]
			    do
				if [ $# -eq 0 ]; then
				    printf 'ERROR: Missing concluding "%s" after "%s" separator.\n' "$sep" '--entries-separated-by|-E'
				    echo
				    printUsage "$0"
				    exit 2
				fi >&2

				entries+=("$1"); shift
			    done
			    shift
			    haveEntries=t
			    argCount $((originalArgNum - $#)) entries
			    ;;
	--entries|-e)	    originalArgNum=$#; shift
			    until [ $# -eq 0 -o "$1" = '--' ]
			    do
				entries+=("$1"); shift
			    done
			    haveEntries=t
			    argCount $((originalArgNum - $#)) entries
			    ;;
	--)		    shift; break;;
	-[^0-9]*)	    noUnderstand; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		    break;
    esac
done

isFirstSelection=t
isFuzzySelection=
isSubtract=
typeset -a selected=()
typeset -a matches=()
while [ $# -ne 0 ]
do
    case "$1" in
	--)			endOfOptionsAndParameters; shift; break;;
	//)			if [ "$isFirstSelection" ]; then shift; isSubtract=t; fi
				option selection; break
				;;
	${fuzzyTrigger:---})	if [ -n "$isFirstSelection" -a $# -eq 1 ]; then shift; isFuzzySelection=t; fi
				option selection; break
				;;
	?(/?(-)|-)+([0-9]))	selected+=("$1"); shift; option selection;;
	+([0-9])-+([0-9]))	eval "selected+=({${1/-/..}})"; shift; option selection;;
	/+([0-9])-+([0-9]))	range="${1#/}"; eval "selected+=(/{${range/-/..}})"; shift; option selection;;
	+([0-9])-)		if [ "$1" = '1-' ]; then echo >&2 "Cannot select all entries like this."; exit 2; fi
				previous=$((${1%-} - 1)); eval "selected+=(/{1..$previous})"; shift; option selection
				;;
	*)			if [ -n "$matchFunction" ]; then
				    matches+=("$1")
				    shift; option selection
				else
				    endOfOptionsAndParameters; break
				fi
				;;
    esac
    isFirstSelection=
done
if [ ${#selected[@]} -gt 0 -a ${#matches[@]} -gt 0 ]; then
    echo 'ERROR: Cannot pass both SELECTIONs and MATCHes.'
    exit 2
fi >&2

#if [ "$haveEntries" ] # Ignore stuff after -- if --entries-separated-by have been used.
if [ ! "$haveEntries" ] && [ $# -gt 0 ]; then
    entries=("$@")
elif [ "$isStdin" ]; then
    readarray -O ${#entries[@]} -t entries  # Append to entries supplied via --entries-separated-by or --entries.
    { exec 0</dev/tty; } 2>/dev/null || exit $?
fi

if [ ${#entries[@]} -gt 0 -a -n "${filter+t}" ]; then
    entrySource="$filter"
else
    entrySource="$generator"
fi
if [ -n "$entrySource" ]; then
    for entry in "${entries[@]}"
    do
	printf -v entry %q "$entry"
	quotedEntries+="${quotedEntries:+ }${entry}"
    done

    typeset -a e=("${entries[@]}")
    interpolatedEntrySource="${entrySource//"$filterMarker"/$quotedEntries}"
    [ "$interpolatedEntrySource" = "$entrySource" ] || e=()

    readarray -t entries < <(eval "$interpolatedEntrySource" '"${e[@]}"')
fi


isInteractiveSelection=
if [ ${#entries[@]} -eq 0 ]; then
    printIfDefined "$noEntriesMessage"
    exit 124
elif [ ${#entries[@]} -eq 1 ] && [ "$isAcceptSingle" ]; then
    typeset -a selectedEntries=("${entries[@]}")
else
    if [ ${#selected[@]} -eq 0 -a ${#matches[@]} -eq 0 ]; then
	isInteractiveSelection=t
	printIfDefined "$prompt"
    fi

    isFirst=t
    typeset -a selectedEntries=()
    invertCandidates()
    {
	typeset -a invertedEntries=()
	for entry
	do
	    contains "$entry" "${selectedEntries[@]}" || invertedEntries+=("$entry")
	done
	selectedEntries=("${invertedEntries[@]}")
    }
    typeset -a filters=()
    applyFilter()
    {
	local isFilterShowsAll="${1?}"; shift
	if [ $# -eq 0 ]; then
	    echo >&2 'No results from filtering.'
	else
	    filters+=("$REPLY")
		save_isOfferingsLimited="$isOfferingsLimited"
		save_isShowAll="$isShowAll"
		[ "$isFilterShowsAll" ] && isShowAll=t
		    selectCandidates "$@"
		isShowAll="$save_isShowAll"
		isOfferingsLimited="$save_isOfferingsLimited"
		[ ${#filters[@]} -gt 0 ] || return 1
	    filters=("${filters[@]:0:$((${#filters[@]}-1))}")
	    setPrompt
	fi
    }
    clearFilters()
    {
	filters=()
	setPrompt
    }
    printCurrentFilter()
    {
	local entryNum=${1:?}; shift
	local prefix="${1:?}"; shift
	local offeringsLimitation; [ "$isOfferingsLimited" ] && offeringsLimitation=" showing ${#offerings[@]} of $entryNum entries"
	case $# in
	    0)	;;
	    1)	printf >&2 '%s at full list of %s; press %s%s%s to show again.\n' \
		    "${prefix}${offeringsLimitation}" \
		    "$entryNamePlural" \
		    "$COMMANDONSELECTED_KEY_PREFIX" Enter "$COMMANDONSELECTED_KEY_SUFFIX"
		;;
	    *)	printf >&2 '%s at filter %s\n%sPress %s%s%s to show %s again, %s%s%s or %s%s%s to leave this filter,\n%s%s%s%s to finish selecting.\n' \
		    "${prefix}${offeringsLimitation}" \
		    "$(printf '%s\n' "${@:1:$(($#-1))}" | surround -- "$COMMANDONSELECTED_FILTER_PREFIX" "$COMMANDONSELECTED_FILTER_SUFFIX" | joinBy - ' | ')" \
		    "${prefix%%+([^	 ])}" \
		    "$COMMANDONSELECTED_KEY_PREFIX" Enter "$COMMANDONSELECTED_KEY_SUFFIX" \
		    "$entryNamePlural" \
		    "$COMMANDONSELECTED_KEY_PREFIX" Ctrl-D "$COMMANDONSELECTED_KEY_SUFFIX" \
		    "$COMMANDONSELECTED_SYNTAX_PREFIX" .. "$COMMANDONSELECTED_SYNTAX_SUFFIX" \
		    "${prefix%%+([^	 ])}" \
		    "$COMMANDONSELECTED_SYNTAX_PREFIX" . "$COMMANDONSELECTED_SYNTAX_SUFFIX"
		;;
	esac
    }
    setPrompt()
    {
	PS3='#'
	[ ${#filters[@]} -gt 0 ] && PS3="(${PS3})"
	[ "$isOfferingsLimited" ] && PS3="[${PS3}]"
	PS3+='? '

    }
    isShowAll=
    selectCandidates()
    {
	[ "$isOneEntryPerLine" ] && COLUMNS=1

	if [ -n "$LINES" ] && [ $# -ge $LINES ] && [ ! "$isShowAll" ]; then
	    # Not enough space to show all available entries; only show as many as fit the
	    # screen.
	    isOfferingsLimited=t
	    typeset -a offerings=("${@:1:$((LINES - 1))}")
	else
	    isOfferingsLimited=
	    typeset -a offerings=("$@")
	fi

	setPrompt
	local entry; select entry in "${offerings[@]}"
	do
	    if [ "$entry" ]; then
		selectedEntries+=("$entry")
	    else
		local isBreak=
		case "$REPLY" in
		    .)  clearFilters;&
		    ..) isBreak=t;;
		    //) invertCandidates "$@"; isBreak=t;;
		    ${fuzzyTrigger:-.})
			selectFuzzy "$@"; isBreak=t;;
		    \?) cat >&2 <<-EOF
			    Enter each number (one after the other) to select the entry.
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}2-5${COMMANDONSELECTED_SYNTAX_SUFFIX} or ${COMMANDONSELECTED_SYNTAX_PREFIX}3-${COMMANDONSELECTED_SYNTAX_SUFFIX} are ranges
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}-3${COMMANDONSELECTED_SYNTAX_SUFFIX} negative numbers select from the end
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}/N${COMMANDONSELECTED_SYNTAX_SUFFIX} selects all but entry N
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}*${COMMANDONSELECTED_SYNTAX_SUFFIX} selects all entries.
			    Filtering:
EOF
			    [ "$isOfferingsLimited" ] && [ ! "$isShowAll" ] \
				&& echo >&2 "    · ${COMMANDONSELECTED_SYNTAX_PREFIX}+${COMMANDONSELECTED_SYNTAX_SUFFIX} shows all entries (with scrolling)"
			    cat >&2 <<-EOF
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}+2-5${COMMANDONSELECTED_SYNTAX_SUFFIX} or ${COMMANDONSELECTED_SYNTAX_PREFIX}+-9${COMMANDONSELECTED_SYNTAX_SUFFIX} or ${COMMANDONSELECTED_SYNTAX_PREFIX}+3-${COMMANDONSELECTED_SYNTAX_SUFFIX} limits shown entries to that range
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}-2-5${COMMANDONSELECTED_SYNTAX_SUFFIX} or ${COMMANDONSELECTED_SYNTAX_PREFIX}--9${COMMANDONSELECTED_SYNTAX_SUFFIX} or ${COMMANDONSELECTED_SYNTAX_PREFIX}-3-${COMMANDONSELECTED_SYNTAX_SUFFIX} excludes entries in that range from being shown
			    · ${COMMANDONSELECTED_SYMBOLIC_PREFIX}PATTERN|GREP-ARGUMENTS [...]${COMMANDONSELECTED_SYMBOLIC_SUFFIX} filter the list
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}\$${COMMANDONSELECTED_SYNTAX_SUFFIX}${COMMANDONSELECTED_SYMBOLIC_PREFIX}SHELL-COMMAND [...]${COMMANDONSELECTED_SYMBOLIC_SUFFIX} filters (or even modifies) the list
			      (Use normal shell syntax, except backslashes need to be doubled.)
EOF
			if [ ${#filters[@]} -gt 1 ]; then
			    cat >&2 <<-EOF
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}..${COMMANDONSELECTED_SYNTAX_SUFFIX} (standalone or appended to entries) or ${COMMANDONSELECTED_KEY_PREFIX}Ctrl-D${COMMANDONSELECTED_KEY_SUFFIX} leave the current filter
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}.${COMMANDONSELECTED_SYNTAX_SUFFIX} (standalone or appended to entries) finish selecting altogether
EOF
			else
			    cat >&2 <<-EOF
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}.${COMMANDONSELECTED_SYNTAX_SUFFIX} (standalone or appended to entries) or ${COMMANDONSELECTED_KEY_PREFIX}Ctrl-D${COMMANDONSELECTED_KEY_SUFFIX} finish selecting
EOF
			fi
			cat >&2 <<-EOF
			    · ${COMMANDONSELECTED_SYNTAX_PREFIX}//${COMMANDONSELECTED_SYNTAX_SUFFIX} takes the inversion (i.e. all not selected entries)${fuzzyTrigger:+
    · ${COMMANDONSELECTED_SYNTAX_PREFIX}${fuzzyTrigger}${COMMANDONSELECTED_SYNTAX_SUFFIX} switches to fuzzy matching (using fzf)}
EOF
			printCurrentFilter $# '    Currently' "${filters[@]}" ''
			if [ ${#selectedEntries[@]} -eq 0 ]; then
			    echo >&2 'Nothing selected yet.'
			else
			    local IFS=' '
			    printf >&2 '%d out of %d selected: %s\n' ${#selectedEntries[@]} ${#entries[@]} "$(joinBy ', ' "${selectedEntries[@]}")"
			fi
			[ "$isOneEntryPerLine" ] && COLUMNS=1	# XXX: Need to reapply this here somehow?!
			;;
		    \**( ).)
			clearFilters;&
		    \**( )..)
			isBreak=t
			;&
		    \*)
			selectedEntries+=("$@")
			;;
		    +([0-9])*( ).)
			clearFilters;&
		    +([0-9])*( )..)
			selectedEntries+=("${@:${REPLY%%*( )+(.)}:1}")
			isBreak=t
			;;
		    +([0-9]))
			entryPlural="$entryNamePlural"; [ ${#offerings[@]} -eq 1 ] && entryPlural="$entryName"
			filterNote=; [ ${#filters[@]} -eq 0 ] || filterNote='filtered'
			printf >&2 'Only %d%s %s%s.\n' ${#offerings[@]} "${filterNote:+ }${filterNote}" "$entryPlural" "${isOfferingsLimited:+ shown}"
			;;
		    ?(-)+([0-9])+( ?(-)+([0-9]))*( ).)
			clearFilters;&
		    ?(-)+([0-9])+( ?(-)+([0-9]))*( )..)
			REPLY="${REPLY%%*( )+(.)}"
			isBreak=t
			;&
		    ?(-)+([0-9])+( ?(-)+([0-9])))
			eval "selected=($REPLY)"
			selectByCounts "$@"
			;;
		    @(/?(-)|-)+([0-9])*( ).)
			clearFilters;&
		    @(/?(-)|-)+([0-9])*( )..)
			REPLY="${REPLY%%*( )+(.)}"
			isBreak=t
			;&
		    @(/?(-)|-)+([0-9]))
			selected=("$REPLY")
			selectByCounts "$@"
			;;
		    +([0-9])-+([0-9])*( ).)
			clearFilters;&
		    +([0-9])-+([0-9])*( )..)
			REPLY="${REPLY%%*( )+(.)}"
			isBreak=t
			;&
		    +([0-9])-+([0-9]))
			eval "selected=({${REPLY/-/..}})"
			selectByCounts "$@"
			;;
		    /+([0-9])-+([0-9])*( ).)
			clearFilters;&
		    /+([0-9])-+([0-9])*( )..)
			REPLY="${REPLY%%*( )+(.)}"
			isBreak=t
			;&
		    /+([0-9])-+([0-9]))
			range="${REPLY#/}"; eval "selected=(/{${range/-/..}})"
			selectByCounts "$@"
			;;
		    +([0-9])-*( ).)
			clearFilters;&
		    +([0-9])-*( )..)
			REPLY="${REPLY%%*( )+(.)}"
			isBreak=t
			;&
		    +([0-9])-)
			eval "selected=({${REPLY%-}..${#offerings[@]}})"
			selectByCounts "$@"
			;;

		    +)	if [ "$isShowAll" ]; then
			    echo >&2 'Already showing all entries.'
			else
			    isShowAll=t
			    selectCandidates "$@"
			    isBreak=t
			fi
			;;
		    [+-]+([0-9])-*([0-9]))
			;&
		    [+-]*([0-9])-+([0-9]))
			local filterAction="${REPLY:0:1}"; filterRange="${REPLY:1}"
			local startCnt=${filterRange%%-*} endCnt=${filterRange#*-}
			startCnt=${startCnt:-1} endCnt=${endCnt:-${#offerings[@]}}
			case "$filterAction" in
			    +)	applyFilter t "${@:startCnt:endCnt - startCnt + 1}" || break;;
			    -)	applyFilter t "${@:1:startCnt - 1}" "${@:endCnt + 1}" || break;;
			    *)	printf >&2 'ASSERT: Invalid filterAction: %s\n' "$filterAction"; exit 3;;
			esac
			;;
		    *)	[[ "$REPLY" = \$* ]] \
			    && local filterCommand="${REPLY#\$}" \
			    || local filterCommand="grep $REPLY"
			typeset -a filteredEntries=(); readarray -t filteredEntries < <(unset IFS; printf '%s\n' "$@" | eval "$filterCommand")
			applyFilter '' "${filteredEntries[@]}" || break
			;;
		esac
		if [ "$isBreak" ]; then
		    printCurrentFilter $# 'Back' "${filters[@]}"
		    break
		fi
	    fi

	    [ ${#selectedEntries[@]} -eq 1 -a ! "$isMultiSelect" ] && break
	done < "${USERQUERY_INPUT:-/dev/tty}"
	[ "$isSubtract" ] && invertCandidates "$@"
	shift
    }
    selectByCounts()
    {
	local s
	for s in "${selected[@]}"
	do
	    local isSubtract=
	    local count
	    case "$s" in
		/*)	[ "$isFirst" ] && selectedEntries=("$@")
			isSubtract=t
			if [ "${s:1:1}" = '-' ]; then
			    count=$(($# - ${s:2} + 1))
			else
			    count=${s:1}
			fi
			;;
		-*)	count=$(($# - ${s:1} + 1));;
		*)	count=$s;;
	    esac
	    isFirst=

	    if [ $count -lt 1 -o $count -gt $# ]; then
		entryPlural="$entryNamePlural"; [ $# -eq 1 ] && entryPlural="$entryName"
		printf >&2 'Only %d %s.\n' $# "$entryPlural"
		exit 2
	    fi

	    if [ "$isSubtract" ]; then
		let count-=1	# Array indexing is 0-based.
		unset selectedEntries[$count]
	    else
		selectedEntries+=("${@:$count:1}")
	    fi
	done
    }
    selectByMatch()
    {
	local entry; for entry
	do
	    local literal
	    for literal in "${matches[@]}"
	    do
		[ "$literal" = "$entry" ] && ! contains "$entry" "${selectedEntries[@]}" && selectedEntries+=("$entry")
	    done
	done
    }
    selectByGlob()
    {
	local entry; for entry
	do
	    local glob
	    for glob in "${matches[@]}"
	    do
		case "$entry" in
		    @($glob)) ! contains "$entry" "${selectedEntries[@]}" && selectedEntries+=("$entry");;
		esac
	    done
	done
    }
    selectFuzzy()
    {
	readarray -O ${#selectedEntries[@]} -t selectedEntries < <(printf '%s\n' "$@" | fzf ${isMultiSelect:+--multi})
    }

    if [ ${#selected[@]} -gt 0 ]; then
	selectByCounts "${entries[@]}"
    elif [ ${#matches[@]} -gt 0 ]; then
	"$matchFunction" "${entries[@]}"
	[ ${#selectedEntries[@]} -eq 0 ] && printf >&2 'No matches for %s.\n' "$(joinBy ' or ' "${matches[@]}")"
    else
	userprequery || exit $?
	if [ "$isFuzzySelection" ]; then
	    selectFuzzy "${entries[@]}"
	else
	    selectCandidates "${entries[@]}"
	fi
    fi
fi


[ ${#selectedEntries[@]} -eq 0 ] && exit 125

if [ ! "$isMultiSelect" -a ${#selectedEntries[@]} -gt 1 ]; then
    printf >&2 'Note: %d %s selected; ignoring all but the first.\n' "${#selectedEntries[@]}" "$entryNamePlural"
    selectedEntries=("${selectedEntries[0]}")
fi

if [ -n "$postFilter" ]; then
    for selectedEntry in "${selectedEntries[@]}"
    do
	printf -v selectedEntry %q "$selectedEntry"
	quotedSelectedEntries+="${quotedSelectedEntries:+ }${selectedEntry}"
    done

    typeset -a se=("${selectedEntries[@]}")
    interpolatedPostFilter="${postFilter//"$postFilterMarker"/$quotedSelectedEntries}"
    [ "$interpolatedPostFilter" = "$postFilter" ] || se=()

    readarray -t selectedEntries < <(eval "$interpolatedPostFilter" '"${se[@]}"')
fi

# Print any messages only now after a potential post-filter has been applied.
if [ ${#entries[@]} -eq 1 -a "$isAcceptSingle" ]; then
    printIfDefined "$autoSelectedEntryMessage" "${selectedEntries[0]}"
elif [ -n "$selectionMessage" ] || [ "$isInteractiveSelection" -a -n "$interactiveSelectionMessage" ]; then
    selectedEntriesCharacterization="$(joinBy --summarize-larger "$COMMANDONSELECTED_SELECTION_MESSAGE_MAX_ENUMERATION_COUNT entries" ', ' "${selectedEntries[@]}")"
    [ "$isInteractiveSelection" ] && \
	printIfDefined "$interactiveSelectionMessage" "$selectedEntriesCharacterization" || \
	printIfDefined "$selectionMessage" "$selectedEntriesCharacterization"
fi

printf -v quotedSelectedEntries '%q ' "${selectedEntries[@]}"; quotedSelectedEntries="${quotedSelectedEntries% }"
if [ -n "$targetCommands" ]; then
    interpolatedCommands="${targetCommands//"$entriesMarker"/$quotedSelectedEntries}"
    [ "$interpolatedCommands" = "$targetCommands" ] || quotedSelectedEntries=''
else
    interpolatedCommands="printf '%s\\n'"
fi

eval "$interpolatedCommands" "$quotedSelectedEntries"
