#!/bin/bash
set -o pipefail

: ${MAPSELECTEDLINES_COMMAND_JOINER=;}
: ${MAPSELECTEDLINES_EXEC_END=;}
: ${MAPSELECTEDLINES_LINES_END=;}

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" "-n|--select-line-number NR|-N|--skip-line-number NR|-l|--select-line LINE|-L|--skip-line LINE|--select-lines LINE [...] ${MAPSELECTEDLINES_LINES_END}|--skip-lines LINE [...] ${MAPSELECTEDLINES_LINES_END}|-m|--select-match PATTERN|-M|--skip-match PATTERN [...] -c|--command \"COMMANDLINE\" [-c ...] | --exec SIMPLECOMMAND [...] ${MAPSELECTEDLINES_EXEC_END} [--exec ...] | [--] SIMPLECOMMAND [...] [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Read lines from standard input and pass them on to COMMAND, which is supposed to
transform them, but keep the overall amount of lines the same. Extract those
lines (by their position in the input) that were selected, and print the
corresponding transformed lines.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --select-line-number|-n NR
			Select the line with the number NR for output.
    --skip-line-number|-N NR
			All lines except the one with number NR are selected for
			output. Skips take precedence over selects.
    --select-line|-l LINE
			Select the line LINE for output.
    --skip-line|-L LINE	All lines except LINE are selected for output.
			Skips take precedence over selects.
    --select-lines LINE [...] ${MAPSELECTEDLINES_LINES_END}
			Select the following LINE(s); i.e. all following
			arguments until an argument consisting of '${MAPSELECTEDLINES_LINES_END}' is
			encountered.
    --skip-lines LINE [...] ${MAPSELECTEDLINES_LINES_END}
			All lines except the following LINE(s) are
			selected; i.e. all following arguments until an argument
			consisting of '${MAPSELECTEDLINES_LINES_END}' is encountered.
    --select-match|-m PATTERN
			Select all lines that match the regular expression
			PATTERN for output.
    --skip-match|-M PATTERN
			All lines except those that match the regular expression
			PATTERN are selected for output. Skips take precedence
			over selects.
    All PATTERNs are POSIX-style unanchored extended regular expressions.
    --command|-c CMD	The command line to be executed. When this is a simple
			command, it can also be passed as such.
    --exec CMD [...] ${MAPSELECTEDLINES_EXEC_END}	Execute CMD; all following arguments are taken to be
			arguments to the CMD until an argument consisting of
			'${MAPSELECTEDLINES_EXEC_END}' is encountered.
EXIT STATUS:
    0	Complete success.
    2	Bad invocation, wrong or missing command-line arguments.
    4	No lines were selected.
    5	COMMAND(s) did not produce the same number of output lines as input
	lines.
    99	No input lines were read.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

hasSelection=
typeset -A selectedLineIndices=()
typeset -A skippedLineIndices=()
typeset -A selectedLines=()
typeset -A skippedLines=()
typeset -A selectedMatches=()
typeset -A skippedMatches=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;

	--select-line-number|-n)
			shift; selectedLineIndices[$((${1:?} - 1))]=t; shift; hasSelection=t;;
	--skip-line-number|-N)
			shift; skippedLineIndices[$((${1:?} - 1))]=t; shift;;
	--select-line|-l)
			shift; selectedLines["${1:-$'\n'}"]=t; shift; hasSelection=t;;
	--skip-line|-L)
			shift; skippedLines["${1:-$'\n'}"]=t; shift;;
	--select-lines)	shift
			while [ $# -gt 0 -a "$1" != "$MAPSELECTEDLINES_LINES_END" ]
			do
			    selectedLines["${1:-$'\n'}"]=t
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --select-lines must be concluded with '${MAPSELECTEDLINES_LINES_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			if [ ${#selectedLines[@]} -eq 0 ]; then
			    echo 'ERROR: --select-lines must be followed by at least one LINE.'; echo; printUsage "$0"
			    exit 2
			fi >&2
			hasSelection=t
			;;
	--skip-lines)	shift
			while [ $# -gt 0 -a "$1" != "$MAPSELECTEDLINES_LINES_END" ]
			do
			    skippedLines["${1:-$'\n'}"]=t
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --select-lines must be concluded with '${MAPSELECTEDLINES_LINES_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			if [ ${#skippedLines[@]} -eq 0 ]; then
			    echo 'ERROR: --skip-lines must be followed by at least one LINE.'; echo; printUsage "$0"
			    exit 2
			fi >&2
			;;
	--select-match|-m)
			shift; selectedMatches["${1:?}"]=t; shift; hasSelection=t;;
	--skip-match|-M)
			shift; skippedMatches["${1:?}"]=t; shift;;

	--command|-c)	shift; commands+="${commands:+ $MAPSELECTEDLINES_COMMAND_JOINER }$1"; shift;;
	--exec)		shift
			cmd=
			while [ $# -gt 0 -a "$1" != "$MAPSELECTEDLINES_EXEC_END" ]
			do
			    printf -v quotedArg %q "$1"
			    cmd+="${cmd:+ }${quotedArg}"
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --exec command must be concluded with '${MAPSELECTEDLINES_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			commands+="${commands:+ $MAPSELECTEDLINES_COMMAND_JOINER }${cmd}"
			;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    # Combine --command and SIMPLECOMMAND; need to quote SIMPLECOMMAND to
    # undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    commands+="${commands:+ $MAPSELECTEDLINES_COMMAND_JOINER }${quotedSimpleCommand% }"
fi
if [ -z "$commands" ]; then
    echo "ERROR: No COMMAND(s) specified; need to pass -c|--command \"COMMANDLINE\", or --exec SIMPLECOMMAND [...] $MAPSELECTEDLINES_EXEC_END or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
elif [ ! "$hasSelection" ] && [ ${#skippedLineIndices[@]} -eq 0 ] && [ ${#skippedLines[@]} -eq 0 ] && [ ${#skippedMatches[@]} -eq 0 ]; then
    echo 'ERROR: No selections passed.'
    echo
    printUsage "$0"
    exit 2
fi >&2

hasMatch()
{
    local line="${1?}"; shift
    for pattern
    do
	[[ "$line" =~ $pattern ]] && return 0
    done
    return 1
}

# Prevent that readarray consumes following lines by reading from stdin.
# Instead, redirect stdin directly from the terminal (if available), or the null
# device. Note: For some commands, you can also directly influence their
# behavior; e.g. ssh -n.
exec 3<&0
# Force reading directly from terminal / null device if stdin is redirected,
# to avoid consuming input.
{ exec 0</dev/tty; } 2>/dev/null || exec </dev/null

typeset -a lines=()
let lineIdx=-1
typeset -a resultIndices=()
while IFS=$'\n' read -r line || [ -n "$line" ]
do
    lines+=("$line")
    let lineIdx+=1
    keyLine="${line:-$'\n'}"

    if [ "${skippedLineIndices["$lineIdx"]}" ] \
	|| [ "${skippedLines["$keyLine"]}" ] \
	|| hasMatch "$line" "${!skippedMatches[@]}"
    then
	continue
    fi

    if [ ! "$hasSelection" ] \
	|| [ "${selectedLineIndices["$lineIdx"]}" ] \
	|| [ "${selectedLines["$keyLine"]}" ] \
	|| hasMatch "$line" "${!selectedMatches[@]}"
    then
	resultIndices+=($lineIdx)
    fi
done <&3

[ ${#lines[@]} -gt 0 ] || exit 99
[ ${#resultIndices[@]} -gt 0 ] || exit 4

readarray -t resultingLines < <(printf '%s\n' "${lines[@]}" | eval "$commands"; printf '\n%d\n' "$?")	# Exit status from the process substitution is lost; return the actual exit status via an appended additional line.
status=${resultingLines[-1]}
unset 'resultingLines[-1]'; [ -n "${resultingLines[-1]}" ] || unset 'resultingLines[-1]'

if [ ${#resultingLines[@]} -ne ${#lines[@]} ]; then
    printf >&2 'ERROR: The number of output lines (%d) does not match the number of input lines (%d).\n' ${#resultingLines[@]} ${#lines[@]}
    exit 5
fi

for idx in "${resultIndices[@]}"
do
    printf '%s\n' "${resultingLines[idx]}"
done
exit $status
